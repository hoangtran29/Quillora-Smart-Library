# Quillora / LibMate AI — environment template
# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit file `.env`.

# === Bắt buộc ===
# Google Gemini (LLM + Voice Live). Lấy ở https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Khuyên dùng ===
# fal.ai (Visualize). Lấy ở https://fal.ai/dashboard/keys
# Để trống sẽ dùng ảnh stub.
FAL_API_KEY=

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=true

# === LLM model ===
LLM_MODEL=gemini-2.5-flash-lite
VOICE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# === RAG ===
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=4

# === Auth ===
# Đổi sang chuỗi random dài (vd: openssl rand -hex 32) trước khi deploy.
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL=604800

# === Auth0 (Microsoft OAuth) — optional ===
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:8000/api/auth/microsoft/callback
